# Application
APP_NAME="Trading Academy"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trading_academy
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LICENSE_PUBLIC_KEY_PATH=keys/license_public.pem
LICENSE_PRIVATE_KEY_PATH=keys/license_private.pem

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Internationalization
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en","fa","de"]
LOCALE_DIR=locale

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# External APIs (Optional)
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINGECKO_API_KEY=
NEWSAPI_KEY=

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090